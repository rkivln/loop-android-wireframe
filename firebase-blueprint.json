{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing identity, stats, badges, and contact details for Loop community members",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user UID matching auth" },
        "displayName": { "type": "string", "description": "Public display name" },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "bio": { "type": "string", "description": "Member biography" },
        "location": { "type": "string", "description": "Neighborhood in Puducherry" },
        "avatarPresetIndex": { "type": "number", "description": "Selected avatar preset icon index" },
        "customAvatarUri": { "type": "string", "description": "Optional custom avatar image URI" },
        "rating": { "type": "number", "description": "Average member rating" },
        "reviewCount": { "type": "number", "description": "Total reviews count" },
        "rentalsCompleted": { "type": "number", "description": "Number of rentals fulfilled" },
        "listingsCount": { "type": "number", "description": "Number of active equipment listings" },
        "earnedAmount": { "type": "number", "description": "Total earnings in INR" },
        "isVerified": { "type": "boolean", "description": "Community verified status" },
        "memberSince": { "type": "string", "description": "Joined date string" },
        "badges": { "type": "array", "description": "Earned community badges" },
        "favoriteItemIds": { "type": "array", "description": "IDs of saved favorite catalog items" },
        "favoriteHouseIds": { "type": "array", "description": "IDs of saved favorite house rentals" },
        "legacyResetVersion": { "type": "number", "description": "Version flag for zero-mock reset" },
        "appearanceMode": { "type": "string", "description": "Preferred UI theme: LIGHT, DARK, or SYSTEM" },
        "profileVisibility": { "type": "string", "description": "Profile visibility level: PUBLIC, COMMUNITY_ONLY, or PRIVATE" },
        "locationSharing": { "type": "string", "description": "Location sharing mode: PRECISE, NEIGHBORHOOD_ONLY, or HIDDEN" },
        "notifyPush": { "type": "boolean", "description": "Master push notifications preference toggle" },
        "notifyNewPosts": { "type": "boolean", "description": "Alerts for new neighborhood posts" },
        "notifyCommentReplies": { "type": "boolean", "description": "Alerts for replies to user comments" },
        "notifyLikes": { "type": "boolean", "description": "Alerts for likes and interactions" },
        "notifyAnnouncements": { "type": "boolean", "description": "Platform announcements preference" },
        "blockedUserIds": { "type": "array", "description": "List of blocked user UIDs filtered from feeds" },
        "blockedUsers": { "type": "array", "description": "Blocked user records containing userId and displayName" },
        "fcmToken": { "type": "string", "description": "Firebase Cloud Messaging device registration token" },
        "fcmTokenUpdatedAt": { "type": "string", "format": "date-time", "description": "Last FCM token registration timestamp" },
        "e2eePublicKey": { "type": "string", "description": "Base64 X.509 P-256 ECDH public identity key for Studio Dispatch E2EE" },
        "e2eeKeyFingerprint": { "type": "string", "description": "SHA-256 hex fingerprint of user E2EE public key" },
        "sendReadReceipts": { "type": "boolean", "description": "Whether to send read receipts in Studio Dispatch threads" },
        "showTypingStatus": { "type": "boolean", "description": "Whether to share live typing indicators in Studio Dispatch threads" },
        "defaultDisappearingSeconds": { "type": "number", "description": "Default disappearing messages duration in seconds (0 for Off)" },
        "hideNotificationPreviews": { "type": "boolean", "description": "Mask sender names and message text in incoming chat notifications" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "RentalItem": {
      "title": "RentalItem",
      "description": "Equipment, tools, and creative gear shared for rent in Puducherry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique listing identifier" },
        "title": { "type": "string", "description": "Title of the equipment or gear" },
        "categoryName": { "type": "string", "description": "Rental category name" },
        "pricePerDay": { "type": "number", "description": "Rental fee per day in INR" },
        "location": { "type": "string", "description": "Pickup neighborhood in Puducherry" },
        "rating": { "type": "number", "description": "Item average rating" },
        "reviewCount": { "type": "number", "description": "Total review count" },
        "description": { "type": "string", "description": "Comprehensive gear description" },
        "imageUrl": { "type": "string", "description": "Primary compressed cover photo data URI" },
        "imageUrls": { "type": "array", "description": "Ordered list of up to 4 compressed gallery photo data URIs" },
        "imageCount": { "type": "number", "description": "Total number of attached gallery photos (0-4)" },
        "latitude": { "type": "number", "description": "Optional pickup latitude coordinate" },
        "longitude": { "type": "number", "description": "Optional pickup longitude coordinate" },
        "ownerId": { "type": "string", "description": "UID of owner who listed the item" },
        "ownerName": { "type": "string", "description": "Display name of the owner" },
        "ownerInitials": { "type": "string", "description": "Owner initials for avatar display" },
        "isPopular": { "type": "boolean", "description": "Whether item is featured or popular" },
        "isFavorite": { "type": "boolean", "description": "Favorite bookmark flag" },
        "availableToday": { "type": "boolean", "description": "Instant rental availability flag" },
        "activeBookingId": { "type": "string", "description": "Active booking ID locking this item while reserved or out" },
        "features": { "type": "array", "description": "List of key features and gear specifications" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Listing creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Listing update timestamp" }
      },
      "required": ["id", "title", "categoryName", "pricePerDay", "ownerId", "createdAt"]
    },
    "CommunityEvent": {
      "title": "CommunityEvent",
      "description": "A community event, help request, photowalk, or study group created by community members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of community event or post" },
        "title": { "type": "string", "description": "Headline of the event or initiative" },
        "typeStr": { "type": "string", "description": "Type of event (EVENT, HELP_REQUEST, STUDY_GROUP)" },
        "categoryName": { "type": "string", "description": "Category associated with the event" },
        "description": { "type": "string", "description": "Detailed description of the initiative" },
        "location": { "type": "string", "description": "Street or landmark address in Puducherry" },
        "dateTime": { "type": "string", "description": "Display date and time string" },
        "attendeesOrResponses": { "type": "string", "description": "Summary of registered RSVPs" },
        "attendeeIds": { "type": "array", "description": "UIDs of members who RSVPed or responded" },
        "statusStr": { "type": "string", "description": "Status string (ACTIVE, COMPLETED, ARCHIVED)" },
        "authorId": { "type": "string", "description": "User UID who posted the initiative" },
        "authorName": { "type": "string", "description": "Display name of the author" },
        "latitude": { "type": "number", "description": "Geographical latitude coordinate" },
        "longitude": { "type": "number", "description": "Geographical longitude coordinate" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["id", "title", "typeStr", "statusStr", "authorId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message thread between a renter and a gear host",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique conversation ID" },
        "participantIds": { "type": "array", "description": "Array of member UIDs participating in thread" },
        "hostId": { "type": "string", "description": "UID of gear host" },
        "hostName": { "type": "string", "description": "Name of gear host" },
        "hostInitials": { "type": "string", "description": "Initials of gear host" },
        "hostBadge": { "type": "string", "description": "Badge description of gear host" },
        "hostPhone": { "type": "string", "description": "Contact number of host" },
        "renterId": { "type": "string", "description": "UID of renter" },
        "renterName": { "type": "string", "description": "Name of renter" },
        "itemId": { "type": "string", "description": "Optional associated rental item ID" },
        "itemTitle": { "type": "string", "description": "Optional associated rental item title" },
        "itemPricePerDay": { "type": "number", "description": "Price per day of gear in inquiry" },
        "houseId": { "type": "string", "description": "Optional associated house listing ID" },
        "houseTitle": { "type": "string", "description": "Optional associated house listing title" },
        "houseMonthlyRent": { "type": "number", "description": "Optional monthly rent in INR of house in inquiry" },
        "communityPostId": { "type": "string", "description": "Optional associated community post ID" },
        "communityPostTitle": { "type": "string", "description": "Optional associated community post title" },
        "lastSenderId": { "type": "string", "description": "UID of the last message sender for unread tracking" },
        "isOnline": { "type": "boolean", "description": "Online presence indicator" },
        "isTyping": { "type": "boolean", "description": "Typing status indicator" },
        "unreadCount": { "type": "number", "description": "Count of unread messages" },
        "isPinned": { "type": "boolean", "description": "Pinned thread status" },
        "mutedByUserIds": { "type": "array", "description": "UIDs of participants who muted notifications for this thread" },
        "disappearingTimerSeconds": { "type": "number", "description": "Thread disappearing messages duration in seconds (0 = Off)" },
        "e2eeEnabled": { "type": "boolean", "description": "Whether end-to-end encryption is active on this conversation" },
        "lastMessageText": { "type": "string", "description": "Summary of latest message (neutral placeholder when E2EE)" },
        "lastMessageTimestamp": { "type": "string", "description": "Formatted time of last message" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of most recent activity" }
      },
      "required": ["id", "participantIds", "hostId", "renterId", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual chat message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "senderId": { "type": "string", "description": "UID of user who sent message" },
        "senderName": { "type": "string", "description": "Display name of sender" },
        "text": { "type": "string", "description": "Message text content or neutral encrypted placeholder" },
        "timestampStr": { "type": "string", "description": "Human-readable timestamp string" },
        "timestampEpoch": { "type": "number", "description": "Epoch millisecond value" },
        "isFromMe": { "type": "boolean", "description": "Direction flag" },
        "messageTypeStr": { "type": "string", "description": "Message category (TEXT, IMAGE_MEDIA, LOCATION_PIN, RENTAL_OFFER)" },
        "statusStr": { "type": "string", "description": "Message status (SENT, DELIVERED, READ)" },
        "audioDuration": { "type": "string", "description": "Duration for voice messages" },
        "imageUrl": { "type": "string", "description": "Optional compressed image URI for unencrypted legacy messages" },
        "locationTitle": { "type": "string", "description": "Title of shared GPS location" },
        "locationAddress": { "type": "string", "description": "Address of shared location" },
        "latitude": { "type": "number", "description": "Latitude coordinate for pickup pin" },
        "longitude": { "type": "number", "description": "Longitude coordinate for pickup pin" },
        "itemTitle": { "type": "string", "description": "Title of equipment offered" },
        "itemPricePerDay": { "type": "number", "description": "Daily rental price in offer" },
        "isEncrypted": { "type": "boolean", "description": "Whether message payload is end-to-end encrypted" },
        "keyVersion": { "type": "number", "description": "Encryption scheme version" },
        "ciphertext": { "type": "string", "description": "Base64 AES-256-GCM ciphertext carrying message text, reply snippet, photo, and pin details" },
        "iv": { "type": "string", "description": "Base64 96-bit AES-GCM initialization vector" },
        "senderPublicKey": { "type": "string", "description": "Sender X.509 P-256 public key used for key agreement" },
        "recipientPublicKey": { "type": "string", "description": "Recipient X.509 P-256 public key used for key agreement" },
        "replyToMessageId": { "type": "string", "description": "Optional referenced parent message ID for inline quote replies" },
        "replyToSenderName": { "type": "string", "description": "Display name of parent message author" },
        "expiresAtEpoch": { "type": "number", "description": "Epoch milliseconds timestamp after which message disappears (0 = never)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "senderId", "text", "messageTypeStr", "statusStr", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A rental agreement and reservation between renter and owner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique booking reservation ID" },
        "renterId": { "type": "string", "description": "UID of renter" },
        "renterName": { "type": "string", "description": "Display name of renter" },
        "hostId": { "type": "string", "description": "UID of gear owner" },
        "hostName": { "type": "string", "description": "Display name of host" },
        "itemId": { "type": "string", "description": "ID of reserved rental item" },
        "itemTitle": { "type": "string", "description": "Title of reserved rental item" },
        "startDate": { "type": "string", "description": "Start date string" },
        "endDate": { "type": "string", "description": "End date string" },
        "daysCount": { "type": "number", "description": "Duration in days" },
        "pricePerDay": { "type": "number", "description": "Rate per day in INR" },
        "totalAmount": { "type": "number", "description": "Total payment in INR" },
        "status": { "type": "string", "description": "Booking status: Confirmed, Active, Completed, Cancelled" },
        "deliveryOption": { "type": "string", "description": "Fulfillment option: Self Pickup or Local Delivery" },
        "handoverOtp": { "type": "string", "description": "4-digit verification code for gear handover" },
        "isReviewed": { "type": "boolean", "description": "Whether the borrower has submitted a review" },
        "ratingGiven": { "type": "number", "description": "Rating given by borrower (1-5)" },
        "reviewComment": { "type": "string", "description": "Review text left by borrower" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Booking timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "renterId", "hostId", "itemId", "totalAmount", "status", "createdAt"]
    },
    "HouseListing": {
      "title": "HouseListing",
      "description": "Long-term monthly house rental listing in Loop",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique house listing identifier" },
        "title": { "type": "string", "description": "Editorial title of the property" },
        "propertyType": { "type": "string", "description": "APARTMENT, INDEPENDENT_HOUSE, VILLA, STUDIO, or SHARED_ROOM" },
        "bhkCount": { "type": "number", "description": "Number of bedrooms (0 for studio)" },
        "bathrooms": { "type": "number", "description": "Number of bathrooms" },
        "areaSqFt": { "type": "number", "description": "Carpet or built-up area in square feet" },
        "floorNumber": { "type": "number", "description": "Unit floor level" },
        "totalFloors": { "type": "number", "description": "Total building floors" },
        "furnishing": { "type": "string", "description": "UNFURNISHED, SEMI_FURNISHED, or FULLY_FURNISHED" },
        "tenantPreference": { "type": "string", "description": "ANY, FAMILY, WORKING_PROFESSIONALS, or STUDENTS" },
        "monthlyRent": { "type": "number", "description": "Monthly rent in INR" },
        "securityDeposit": { "type": "number", "description": "Refundable security deposit in INR" },
        "maintenanceMonthly": { "type": "number", "description": "Monthly maintenance fee in INR (0 if included)" },
        "minLeaseMonths": { "type": "number", "description": "Minimum lease duration in months" },
        "availableFromLabel": { "type": "string", "description": "Move-in availability label or date" },
        "isAvailableForRent": { "type": "boolean", "description": "Whether the home is actively accepting visit inquiries" },
        "location": { "type": "string", "description": "Neighborhood and city area" },
        "fullAddressNote": { "type": "string", "description": "Optional street address shared when a visit is confirmed" },
        "description": { "type": "string", "description": "Detailed property description and house rules" },
        "amenities": { "type": "array", "description": "List of amenity keys (WIFI, AC, PARKING_CAR, etc.)" },
        "imageUrl": { "type": "string", "description": "Primary compressed cover photo data URI" },
        "imageUrls": { "type": "array", "description": "Up to 4 compressed room gallery photo data URIs" },
        "photoLabels": { "type": "array", "description": "Room labels corresponding to imageUrls" },
        "imageCount": { "type": "number", "description": "Number of attached gallery photos (0-4)" },
        "latitude": { "type": "number", "description": "Property latitude coordinate" },
        "longitude": { "type": "number", "description": "Property longitude coordinate" },
        "ownerId": { "type": "string", "description": "UID of landlord who published the home" },
        "ownerName": { "type": "string", "description": "Display name of landlord" },
        "ownerInitials": { "type": "string", "description": "Landlord initials" },
        "ownerBadge": { "type": "string", "description": "Landlord community trust badge" },
        "rating": { "type": "number", "description": "Average property/landlord rating" },
        "reviewCount": { "type": "number", "description": "Total review count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["id", "title", "propertyType", "monthlyRent", "ownerId", "createdAt"]
    },
    "HouseVisitRequest": {
      "title": "HouseVisitRequest",
      "description": "Scheduled property tour and long-term rental inquiry between prospective tenant and landlord",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique visit request identifier" },
        "houseId": { "type": "string", "description": "Target house listing ID" },
        "houseTitle": { "type": "string", "description": "Title of the target house" },
        "houseLocation": { "type": "string", "description": "Neighborhood of the target house" },
        "monthlyRent": { "type": "number", "description": "Monthly rent snapshot in INR" },
        "tenantId": { "type": "string", "description": "UID of prospective tenant" },
        "tenantName": { "type": "string", "description": "Display name of prospective tenant" },
        "landlordId": { "type": "string", "description": "UID of landlord" },
        "landlordName": { "type": "string", "description": "Display name of landlord" },
        "preferredDate": { "type": "string", "description": "Requested visit date (YYYY-MM-DD)" },
        "preferredTimeSlot": { "type": "string", "description": "MORNING, AFTERNOON, or EVENING" },
        "occupantsCount": { "type": "number", "description": "Number of prospective occupants" },
        "householdType": { "type": "string", "description": "ANY, FAMILY, WORKING_PROFESSIONALS, or STUDENTS" },
        "targetMoveInMonth": { "type": "string", "description": "Target move-in timeframe" },
        "tenantNote": { "type": "string", "description": "Prospective tenant introduction note" },
        "landlordResponseNote": { "type": "string", "description": "Landlord response or rescheduling note" },
        "confirmedAddressNote": { "type": "string", "description": "Exact landmark or street directions shared on confirmation" },
        "status": { "type": "string", "description": "REQUESTED, CONFIRMED, RESCHEDULE_SUGGESTED, COMPLETED, DECLINED, or CANCELLED" },
        "conversationId": { "type": "string", "description": "Optional linked Studio Dispatch E2EE conversation ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["id", "houseId", "tenantId", "landlordId", "preferredDate", "preferredTimeSlot", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for authenticated Loop members"
    },
    "/items/{itemId}": {
      "schema": "RentalItem",
      "description": "Equipment listings shared for community gear rental"
    },
    "/houses/{houseId}": {
      "schema": "HouseListing",
      "description": "Long-term monthly house rental listings"
    },
    "/visit_requests/{visitId}": {
      "schema": "HouseVisitRequest",
      "description": "Property visit requests and rental inquiries scoped to tenant and landlord"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityEvent",
      "description": "Community events, skill exchanges, photowalks, and study group initiatives"
    },
    "/conversations/{convId}": {
      "schema": "Conversation",
      "description": "Direct message chat channels between members"
    },
    "/conversations/{convId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages in a chat conversation"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Rental bookings and reservations"
    }
  }
}
